{
  "manifest_version": 3,
  "name": "Webpage Scraper",
  "version": "2.0.0",
  "description": "Scrapes webpage content into a Markdown file for data analysis",
  "permissions": [
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
